# Conexao usada pela aplicacao (pooler / pgbouncer).
# Supabase: porta 6543 + ?pgbouncer=true
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexao direta, sem pooler. Usada por `prisma migrate` (migrations nao funcionam
# atraves do pgbouncer). Supabase: porta 5432.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"
