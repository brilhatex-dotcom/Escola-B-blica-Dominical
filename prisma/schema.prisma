// Schema gerado a partir do export real do sistema antigo (Google Apps Script):
//   data/EBD_EXPORT_2026-08-03_1343.json  (planilha 1mFRh_sPmc863fLuXe5zHqKa-TLLcZcwgDnQhxHXVboI)
//
// Convencoes aplicadas:
//   - `id` e a PK original da planilha (@id, SEM autoincrement) para nao quebrar os
//     relacionamentos existentes.
//   - `legacyId` so e preenchido nas poucas linhas cujo id original COLIDIA com outra
//     linha (ver README-IMPORT.md). Nesses casos o id novo fica acima do maximo original
//     e o id da planilha e preservado em legacyId.
//   - congId / classeId sao Int? porque no export vem ora como numero, ora como "".
//     A importacao converte "" em null.
//   - Datas "YYYY-MM-DD" viram DateTime @db.Date (sem hora, imune a fuso).
//     Timestamps ISO completos (registradoEm, when) viram DateTime normal.
//   - Valores monetarios sao Decimal(10,2), nao Float.
//
// Abas presentes no export mas VAZIAS (0 linhas) -> sem model, pois nao ha como inferir
// os campos: Pedidos_Revistas, Obs_Alunos, Visitas_Pastorais, Reunioes_Presenca,
// EBD_Animada, Subsidios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Nao existe aba "Congregacoes" no export. Este model e DERIVADO dos congId
/// distintos encontrados em todas as abas (1..14). O `nome` nasce vazio para
/// ser preenchido manualmente depois.
model Congregacao {
  id   Int    @id
  nome String @default("")

  usuarios           Usuario[]
  classes            Classe[]
  alunos             Aluno[]
  frequencias        Frequencia[]
  freqLicoes         FreqLicao[]
  ofertas            Oferta[]
  visitantes         Visitante[]
  licoes             Licao[]
  escalaCultos       EscalaCulto[]
  eventos            Evento[]
  avisos             Aviso[]
  pessoaCargos       PessoaCargo[]
  auditoria          Auditoria[]
  pagamentosRevistas PagamentoRevista[]
  pedidosRevistas    PedidoRevista[]

  @@map("Congregacoes")
}

model Usuario {
  id       Int     @id
  legacyId Int?
  nome     String
  login    String  @unique
  /// Hash SHA-256 herdado do sistema antigo. NAO re-hashear na importacao.
  senha    String
  perfil   String
  congId   Int?
  classeId Int?
  ativo    Boolean @default(true)

  /// A PESSOA por tras da conta — quando existe uma.
  ///
  /// Fica nulo na maioria das 19 linhas herdadas, e isso esta certo: elas nao
  /// sao pessoas, sao contas de congregacao ("Cong. Pinheiro", "T. Matriz").
  /// Conta e pessoa sao coisas diferentes, e foi confundi-las que fez o sistema
  /// antigo achar que tinha 19 professores.
  pessoaId Int? @unique

  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])
  pessoa      Pessoa?      @relation(fields: [pessoaId], references: [id])

  @@index([congId])
  @@index([classeId])
  @@map("Usuarios")
}

model Classe {
  id         Int     @id
  legacyId   Int?
  nome       String
  faixa      String
  /// Vazio em 3 linhas do export -> null.
  prof       String?
  tipoClasse String
  congId     Int?
  ativa      Boolean @default(true)

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  usuarios     Usuario[]
  alunos       Aluno[]
  frequencias  Frequencia[]
  freqLicoes   FreqLicao[]
  ofertas      Oferta[]
  visitantes   Visitante[]
  pessoaCargos PessoaCargo[]

  @@index([congId])
  @@map("Classes")
}

model Aluno {
  id       Int       @id
  legacyId Int?
  nome     String
  /// Data de nascimento; vazia em 149 linhas do export -> null.
  nasc     DateTime? @db.Date
  /// No export vem como numero (ex.: 87981418516). Guardado como String:
  /// estoura Int32 e telefone nao e aritmetica.
  tel      String?
  resp     String?
  /// Posicao no ministerio: membro, auxiliar, diacono, presbitero, evangelista,
  /// pastor. Ver lib/ebd/posicoes.ts.
  ///
  /// Coluna NOVA e opcional: nasce nula nas 323 linhas herdadas, sem alterar
  /// nenhuma delas. NAO se confunde com `Cargos`/`PessoaCargos`, que guardam o
  /// que a pessoa faz na EBD e decidem o acesso ao portal — um Presbitero pode
  /// nao dar aula nenhuma, e um Professor pode ser Membro.
  posicao  String?
  congId   Int?
  classeId Int?
  ativo    Boolean   @default(true)
  /// Quando esta matrícula nasceu NESTE portal — não a data em que a pessoa
  /// começou na igreja de verdade, que ninguém registrou para as 323 linhas
  /// herdadas. `null` nelas, de propósito: são matrículas antigas, sem
  /// restrição de data. Só quem é matriculado a partir daqui pelo formulário
  /// (`POST /api/alunos`) ganha a data de hoje, automaticamente — e é essa
  /// data que a Chamada usa para não deixar marcar presença ou falta de
  /// alguém em domingo anterior ao dia em que foi matriculado.
  matriculadoEm DateTime? @db.Date

  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])

  frequencias Frequencia[]

  @@index([congId])
  @@index([classeId])
  @@map("Alunos")
}

model Frequencia {
  id       Int      @id
  legacyId Int?
  alunoId  Int
  classeId Int?
  congId   Int?
  data     DateTime @db.Date
  presente Boolean

  aluno       Aluno        @relation(fields: [alunoId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([alunoId])
  @@index([classeId])
  @@index([congId])
  @@index([data])
  @@map("Frequencias")
}

model FreqLicao {
  id          Int      @id
  legacyId    Int?
  classeId    Int?
  congId      Int?
  data        DateTime @db.Date
  licaoId     Int
  licaoTitulo String

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])
  licao       Licao        @relation(fields: [licaoId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@index([licaoId])
  @@map("Freq_Licao")
}

model Licao {
  id         Int      @id
  legacyId   Int?
  ano        Int
  data       DateTime @db.Date
  escopo     String
  tipoClasse String
  titulo     String
  trim       String
  /// Sempre "" no export atual -> null.
  classeId   Int?
  congId     Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  freqLicoes FreqLicao[]

  @@index([congId])
  @@map("Licoes")
}

model Oferta {
  id       Int      @id
  legacyId Int?
  classeId Int?
  congId   Int?
  data     DateTime @db.Date
  obs      String?
  valor    Decimal  @db.Decimal(10, 2)

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@map("Ofertas")
}

model Visitante {
  id       Int       @id
  legacyId Int?
  nome     String
  /// "" em 43 linhas -> null.
  ///
  /// FICA COMO ESTA. As 89 linhas herdadas so tem a idade, e nao a data de
  /// nascimento — calcular uma data a partir dela seria inventar dia e mes.
  /// Nos visitantes novos, quem manda e `nasc`, e a idade e calculada na hora
  /// de exibir; nos antigos, este numero continua sendo a unica verdade.
  idade    Int?
  /// Data de nascimento — SO nos visitantes cadastrados a partir da Fase 09.
  /// Coluna nova e opcional: nasce nula nas 89 linhas antigas, sem altera-las.
  nasc     DateTime? @db.Date
  /// Onde a pessoa mora. Bairro, sitio, povoado — texto livre de propósito:
  /// a zona rural do campo nao cabe numa lista fechada de bairros.
  local    String?
  /// Numero no export -> String (mesmo motivo de Aluno.tel).
  tel      String?
  obs      String?
  /// A situação religiosa: "mesma-igreja" (crente, membro desta própria
  /// igreja — visitou outro culto ou outra congregação do campo),
  /// "outra-igreja" (crente, mas de outra denominação) ou "nao-evangelico".
  /// Decide o retorno: reconduzir à própria igreja, convidar para conhecer,
  /// ou apresentar o evangelho pela primeira vez. `null` = não perguntado,
  /// nas 89 linhas herdadas e em qualquer cadastro feito às pressas.
  ///
  /// Era um Boolean até esta coluna ganhar o terceiro estado ("mesma
  /// igreja") — ver prisma/aplicar-visitante-crente-3-estados.sql, que
  /// converte o que já existia (`true`→"outra-igreja", `false`→
  /// "nao-evangelico") em vez de apagar.
  crente   String?
  classeId Int?
  congId   Int?
  data     DateTime  @db.Date

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@map("Visitantes")
}

/// Sem coluna `id` no export. A chave natural e (key, categoria), unica nas 35 linhas.
model PrecoRevista {
  key       String
  categoria String
  label     String
  preco     Decimal @db.Decimal(10, 2)

  @@id([key, categoria])
  @@map("Precos_Revistas")
}

/// Sem coluna `id` no export; `parametro` e unico.
model Parametro {
  parametro String  @id
  valor     Decimal @db.Decimal(10, 2)

  @@map("Parametros")
}

/// Uma baixa (pagamento parcial) do pedido de revistas de uma congregacao.
///
/// O que se registra aqui e o quanto ja foi pago. Cada baixa e uma entrada —
/// "faltam alunos de varias classes pagarem" vira uma sequencia de baixas com
/// observacao, e o saldo e a diferenca para o total do `PedidoRevista`
/// confirmado. `trimestre` escopa o pedido ("3T-2026").
model PagamentoRevista {
  id         Int      @id @default(autoincrement())
  congId     Int
  trimestre  String
  valor      Decimal  @db.Decimal(10, 2)
  observacao String?
  autor      String?
  criadoEm   DateTime @default(now())

  congregacao Congregacao @relation(fields: [congId], references: [id])

  @@index([congId, trimestre])
  @@map("Pagamentos_Revistas")
}

/// O pedido de revistas de UMA congregacao em UM trimestre — a Fase 15b.
///
/// ============================================================================
/// O PEDIDO E DIGITADO, NAO SO CALCULADO — A FASE 15a TENTOU O CAMINHO
/// AUTOMATICO E NAO ERA O QUE A SECRETARIA PRECISAVA
///
/// A Fase 15a calculava a quantidade sozinha (alunos ativos x preco) e so
/// deixava REGISTRAR PAGAMENTO — nao existia o momento de "a congregacao
/// decidiu e mandou o pedido de verdade". O usuario pediu exatamente isso: uma
/// tela para PREENCHER o pedido, com os numeros comecando ZERADOS (o alerta
/// veio explicito: "zere todos, pois elas vao colocar o novo pedido do IV
/// trimestre").
///
/// Por isso o pedido agora e um registro de verdade, com um passo de
/// CONFIRMAR que TRAVA a quantidade e o preco daquele momento — sem essa
/// trava, um aluno saindo da classe em novembro reduziria silenciosamente o
/// pedido de agosto, que ja foi impresso e enviado pela CPAD. `confirmado`
/// e o que torna "Fechado" (`lib/revistas/situacao.ts`) um estado real: antes
/// de confirmar, a congregacao esta em "sem-pedido" de verdade, nao so
/// aguardando pagamento.
/// ============================================================================
model PedidoRevista {
  id     Int    @id @default(autoincrement())
  congId Int
  /// "3T-2026" — a mesma chave usada em `PagamentoRevista.trimestre`.
  trimestre String

  confirmado    Boolean   @default(false)
  confirmadoEm  DateTime?
  /// Nome de quem confirmou, como veio da sessao — igual a
  /// `PagamentoRevista.autor`. Nao e uma FK: a pessoa pode nao ter mais conta.
  confirmadoPor String?

  criadoEm   DateTime @default(now())
  atualizado DateTime @updatedAt

  congregacao Congregacao         @relation(fields: [congId], references: [id])
  itens       PedidoRevistaItem[]

  @@unique([congId, trimestre])
  @@map("Pedidos_Revistas")
}

/// Uma linha do pedido: uma categoria (ex. "adultos"), um tipo (aluno ou
/// professor), uma quantidade digitada e o preco unitario NO MOMENTO em que a
/// linha foi salva — nao uma referencia a `PrecoRevista`, porque o preco pode
/// mudar de trimestre a trimestre e o pedido confirmado precisa continuar
/// mostrando o valor que foi cobrado, mesmo que a tabela de precos mude
/// depois.
model PedidoRevistaItem {
  id        Int    @id @default(autoincrement())
  pedidoId  Int
  categoria String
  /// "aluno" | "professor"
  tipo          String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)

  pedido PedidoRevista @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@unique([pedidoId, categoria, tipo])
  @@map("Pedidos_Revistas_Itens")
}

/// A data-limite de pagamento de um trimestre — em geral a licao 02 do proximo
/// trimestre, mas editavel. Uma linha por trimestre.
///
/// `dataLimitePedido` (Fase 15a) e um prazo SEPARADO, opcional e sem padrao:
/// fica de fora da tela ate a administracao do campo definir um valor — nunca
/// aparece um prazo que ninguem escolheu. Desde a Fase 15b ele tem um sentido
/// operacional real: e o prazo para CONFIRMAR o `PedidoRevista`.
///
/// `tema` e so exibicao (ex.: "A Grandeza da Graca de Deus") — nao alimenta
/// calculo nenhum.
model TrimestreRevista {
  trimestre        String    @id
  dataLimite       DateTime? @db.Date
  dataLimitePedido DateTime? @db.Date
  tema             String?
  atualizado       DateTime  @updatedAt

  @@map("Trimestres_Revistas")
}

model Reuniao {
  id            Int      @id
  legacyId      Int?
  titulo        String
  tipo          String
  data          DateTime @db.Date
  local         String?
  obs           String?
  autor         String
  /// No export e uma STRING com JSON serializado: [{"nome":..,"presente":bool}].
  /// A importacao faz o parse e grava como jsonb (13/13 linhas validadas).
  participantes Json
  presentes     Int
  total         Int
  registradoEm  DateTime

  @@map("Reunioes")
}

model EscalaCulto {
  id          Int      @id
  legacyId    Int?
  titulo      String
  mesAno      DateTime @db.Date
  dataUpload  DateTime @db.Date
  nomeArquivo String
  url         String
  urlPreview  String
  obs         String?
  autor       String
  congId      Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Escala_Cultos")
}

model Evento {
  id        Int      @id
  legacyId  Int?
  titulo    String
  descricao String
  tipo      String
  local     String
  data      DateTime @db.Date
  dataFim   DateTime @db.Date
  obs       String?
  congId    Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Eventos")
}

model Aviso {
  id             Int      @id
  legacyId       Int?
  titulo         String
  texto          String
  prioridade     Int
  dataPublicacao DateTime @db.Date
  dataExpiracao  DateTime @db.Date
  autor          String
  congId         Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Avisos")
}

/// A partir da Fase 12 o portal TAMBEM grava aqui — ate entao so havia as
/// 1.671 linhas herdadas. Por isso `id` ganhou sequencia (ver
/// prisma/aplicar-fase-12.sql, que a cria comecando acima do maior id
/// importado) e `congId`, que as linhas antigas nao tem.
model Auditoria {
  id       Int      @id @default(autoincrement())
  legacyId Int?
  /// Timestamp ISO completo no export.
  when     DateTime
  who      String
  whoLogin String
  action   String
  entidade String
  desc     String
  /// Nulo em TODAS as linhas do sistema antigo — ele nao registrava
  /// congregacao. E por isso que a leitura continua restrita a quem enxerga o
  /// campo inteiro: filtrar por congregacao esconderia o historico inteiro.
  congId   Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([when])
  @@index([whoLogin])
  @@index([congId])
  @@map("Auditoria")
}

model Versiculo {
  id       Int     @id
  legacyId Int?
  ref      String
  texto    String
  ativo    Boolean @default(true)

  @@map("Versiculos")
}

/**
 * ==========================================================================
 * PESSOAS E CARGOS
 * O sistema antigo nao tinha cadastro de pessoas, e por isso nao conseguia
 * contar gente. Ele tinha duas coisas diferentes:
 * Usuarios  — 19 linhas, mas a maioria nao e pessoa nenhuma: sao contas de
 * congregacao ("Cong. Pinheiro", "T. Matriz", "Templo Sede").
 * Classes.prof — texto livre, digitado por quem cadastrou a classe. Os 50
 * preenchidos produzem 47 textos distintos, e entre eles estao
 * "Ana costa", "Ana maria da costa" e "Ana Maria costa" (a mesma
 * pessoa), "Jéssica e Elisângela" (DUAS pessoas num campo so) e
 * "Classe Juniores" (que nao e pessoa alguma).
 * Contar professores nesse arranjo e impossivel: quem da aula em duas classes
 * vira duas pessoas, e quem e dirigente e professor vira duas de novo.
 * A modelagem abaixo separa QUEM (Pessoa) de O QUE FAZ (Cargo), ligados por
 * PessoaCargo. Uma pessoa pode acumular quantos cargos exercer — e continua
 * sendo uma linha em Pessoa, que e o numero que o Dashboard mostra.
 * ==========================================================================
 */

/// Cadastro unico de gente. Uma linha por PESSOA, nunca por funcao.
model Pessoa {
  id Int @id @default(autoincrement())

  /// Nome civil, SEM tratamento eclesiastico. "Aílton José Alves", nao
  /// "Pr. Aílton José Alves" — senao a mesma pessoa se duplica no dia em que
  /// alguem digitar sem o prefixo, que e exatamente como o texto livre das
  /// classes se multiplicou.
  nome String

  /// Tratamento: "Pr.", "Pb.", "Dc.", "Aux.", "Ir.ª". Guardado a parte para a
  /// exibicao poder ser respeitosa sem contaminar a identidade.
  tratamento String?

  /// Forma normalizada do nome (minusculo, sem acento, sem tratamento).
  /// Existe para impedir "Andreyna Magalhaes" e "Andreyna Magslhaes" de virarem
  /// duas pessoas — e por ser UNIQUE, o banco recusa a duplicata em vez de
  /// depender de a aplicacao lembrar de conferir.
  chave String @unique

  tel   String?
  email String?
  /// Caminho da foto. Quase sempre nulo: o cadastro herdado nao tem fotos.
  foto  String?
  nasc  DateTime? @db.Date

  ativo Boolean @default(true)

  /// Marcada quando a importacao SUSPEITOU de duplicidade mas nao teve certeza
  /// — "Ana costa" e "Ana Maria costa" podem ser a mesma pessoa ou nao. A regra
  /// da igreja e nao alterar registro do sistema antigo por conta propria,
  /// entao a duvida fica registrada para um humano decidir, em vez de o
  /// programa fundir as duas e ninguem mais descobrir.
  revisar    Boolean @default(false)
  observacao String?

  criadoEm   DateTime @default(now())
  atualizado DateTime @updatedAt

  cargos  PessoaCargo[]
  usuario Usuario?

  @@index([nome])
  @@map("Pessoas")
}

/// Lista de funcoes. E dado, nao codigo: cadastrar um cargo novo nao exige
/// alterar o sistema.
model Cargo {
  id Int @id @default(autoincrement())

  nome String @unique

  /// Posicao na hierarquia — MENOR e mais alto. E o que ordena o card
  /// "Liderança do Campo" sem que a ordem esteja escrita em nenhum componente.
  /// Numerado de 10 em 10 para caber um cargo novo no meio sem renumerar tudo.
  ordem Int

  /// "campo" | "congregacao" | "classe" — a que altura o cargo se exerce.
  /// Um Pastor Presidente e do campo inteiro; um Professor, de uma classe.
  escopo String

  /// Aparece no card institucional do Dashboard.
  destaque Boolean @default(false)

  ativo Boolean @default(true)

  vinculos PessoaCargo[]

  @@index([ordem])
  @@map("Cargos")
}

/// O vinculo: esta pessoa exerce este cargo, aqui.
///
/// A linha e o cargo OCUPADO. Duas linhas da mesma pessoa somam dois cargos e
/// uma pessoa — que e precisamente a distincao que o Dashboard precisa mostrar.
model PessoaCargo {
  id Int @id @default(autoincrement())

  pessoaId Int
  cargoId  Int

  /// Onde exerce. Nulo em cargo de campo, que nao pertence a uma congregacao.
  congId   Int?
  /// Preenchido apenas em cargo de classe (professor, secretario de classe).
  classeId Int?

  inicio DateTime? @db.Date
  /// Preenchido quando a pessoa deixa a funcao. O vinculo NAO e apagado: a
  /// escala do ano passado precisa continuar dizendo quem dava a aula.
  fim    DateTime? @db.Date

  ativo Boolean @default(true)

  /// Texto de origem quando o vinculo veio da importacao — por exemplo
  /// "Pb. Lourival e Aux. Danilo", que gerou dois vinculos. Guardado para
  /// qualquer conferencia futura poder voltar ao que estava escrito.
  origem String?

  criadoEm DateTime @default(now())

  pessoa      Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  cargo       Cargo        @relation(fields: [cargoId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])

  /// Impede o mesmo vinculo duas vezes. ATENCAO: em Postgres, NULL nao e igual
  /// a NULL, entao esta restricao sozinha NAO cobre os cargos de campo (congId
  /// e classeId nulos). A migration acrescenta o mesmo indice com
  /// NULLS NOT DISTINCT, que fecha o buraco.
  @@unique([pessoaId, cargoId, congId, classeId])
  @@index([pessoaId])
  @@index([cargoId])
  @@index([congId])
  @@index([classeId])
  @@map("PessoaCargos")
}
