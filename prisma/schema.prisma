// Schema gerado a partir do export real do sistema antigo (Google Apps Script):
//   data/EBD_EXPORT_2026-08-03_1343.json  (planilha 1mFRh_sPmc863fLuXe5zHqKa-TLLcZcwgDnQhxHXVboI)
//
// Convencoes aplicadas:
//   - `id` e a PK original da planilha (@id, SEM autoincrement) para nao quebrar os
//     relacionamentos existentes.
//   - `legacyId` so e preenchido nas poucas linhas cujo id original COLIDIA com outra
//     linha (ver README-IMPORT.md). Nesses casos o id novo fica acima do maximo original
//     e o id da planilha e preservado em legacyId.
//   - congId / classeId sao Int? porque no export vem ora como numero, ora como "".
//     A importacao converte "" em null.
//   - Datas "YYYY-MM-DD" viram DateTime @db.Date (sem hora, imune a fuso).
//     Timestamps ISO completos (registradoEm, when) viram DateTime normal.
//   - Valores monetarios sao Decimal(10,2), nao Float.
//
// Abas presentes no export mas VAZIAS (0 linhas) -> sem model, pois nao ha como inferir
// os campos: Pedidos_Revistas, Obs_Alunos, Visitas_Pastorais, Reunioes_Presenca,
// EBD_Animada, Subsidios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Nao existe aba "Congregacoes" no export. Este model e DERIVADO dos congId
/// distintos encontrados em todas as abas (1..14). O `nome` nasce vazio para
/// ser preenchido manualmente depois.
model Congregacao {
  id   Int    @id
  nome String @default("")

  usuarios     Usuario[]
  classes      Classe[]
  alunos       Aluno[]
  frequencias  Frequencia[]
  freqLicoes   FreqLicao[]
  ofertas      Oferta[]
  visitantes   Visitante[]
  licoes       Licao[]
  escalaCultos EscalaCulto[]
  eventos      Evento[]
  avisos       Aviso[]
  pessoaCargos PessoaCargo[]
  pedidos      PedidoRevista[]

  @@map("Congregacoes")
}

model Usuario {
  id       Int     @id
  legacyId Int?
  nome     String
  login    String  @unique
  /// Hash SHA-256 herdado do sistema antigo. NAO re-hashear na importacao.
  senha    String
  perfil   String
  congId   Int?
  classeId Int?
  ativo    Boolean @default(true)

  /// A PESSOA por tras da conta — quando existe uma.
  ///
  /// Fica nulo na maioria das 19 linhas herdadas, e isso esta certo: elas nao
  /// sao pessoas, sao contas de congregacao ("Cong. Pinheiro", "T. Matriz").
  /// Conta e pessoa sao coisas diferentes, e foi confundi-las que fez o sistema
  /// antigo achar que tinha 19 professores.
  pessoaId Int? @unique

  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])
  pessoa      Pessoa?      @relation(fields: [pessoaId], references: [id])

  @@index([congId])
  @@index([classeId])
  @@map("Usuarios")
}

model Classe {
  id         Int     @id
  legacyId   Int?
  nome       String
  faixa      String
  /// Vazio em 3 linhas do export -> null.
  prof       String?
  tipoClasse String
  congId     Int?
  ativa      Boolean @default(true)

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  usuarios     Usuario[]
  alunos       Aluno[]
  frequencias  Frequencia[]
  freqLicoes   FreqLicao[]
  ofertas      Oferta[]
  visitantes   Visitante[]
  pessoaCargos PessoaCargo[]
  pedidos      PedidoRevista[]

  @@index([congId])
  @@map("Classes")
}

model Aluno {
  id       Int       @id
  legacyId Int?
  nome     String
  /// Data de nascimento; vazia em 149 linhas do export -> null.
  nasc     DateTime? @db.Date
  /// No export vem como numero (ex.: 87981418516). Guardado como String:
  /// estoura Int32 e telefone nao e aritmetica.
  tel      String?
  resp     String?
  congId   Int?
  classeId Int?
  ativo    Boolean   @default(true)

  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])

  frequencias Frequencia[]

  @@index([congId])
  @@index([classeId])
  @@map("Alunos")
}

model Frequencia {
  id       Int      @id
  legacyId Int?
  alunoId  Int
  classeId Int?
  congId   Int?
  data     DateTime @db.Date
  presente Boolean

  aluno       Aluno        @relation(fields: [alunoId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([alunoId])
  @@index([classeId])
  @@index([congId])
  @@index([data])
  @@map("Frequencias")
}

model FreqLicao {
  id          Int      @id
  legacyId    Int?
  classeId    Int?
  congId      Int?
  data        DateTime @db.Date
  licaoId     Int
  licaoTitulo String

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])
  licao       Licao        @relation(fields: [licaoId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@index([licaoId])
  @@map("Freq_Licao")
}

model Licao {
  id         Int      @id
  legacyId   Int?
  ano        Int
  data       DateTime @db.Date
  escopo     String
  tipoClasse String
  titulo     String
  trim       String
  /// Sempre "" no export atual -> null.
  classeId   Int?
  congId     Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  freqLicoes FreqLicao[]

  @@index([congId])
  @@map("Licoes")
}

model Oferta {
  id       Int      @id
  legacyId Int?
  classeId Int?
  congId   Int?
  data     DateTime @db.Date
  obs      String?
  valor    Decimal  @db.Decimal(10, 2)

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@map("Ofertas")
}

model Visitante {
  id       Int      @id
  legacyId Int?
  nome     String
  /// "" em 43 linhas -> null.
  ///
  /// FICA COMO ESTA. As 89 linhas herdadas so tem a idade, e nao a data de
  /// nascimento — calcular uma data a partir dela seria inventar dia e mes.
  /// Nos visitantes novos, quem manda e `nasc`, e a idade e calculada na hora
  /// de exibir; nos antigos, este numero continua sendo a unica verdade.
  idade    Int?
  /// Data de nascimento — SO nos visitantes cadastrados a partir da Fase 09.
  /// Coluna nova e opcional: nasce nula nas 89 linhas antigas, sem altera-las.
  nasc     DateTime? @db.Date
  /// Onde a pessoa mora. Bairro, sitio, povoado — texto livre de propósito:
  /// a zona rural do campo nao cabe numa lista fechada de bairros.
  local    String?
  /// Numero no export -> String (mesmo motivo de Aluno.tel).
  tel      String?
  obs      String?
  classeId Int?
  congId   Int?
  data     DateTime @db.Date

  classe      Classe?      @relation(fields: [classeId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([classeId])
  @@index([congId])
  @@map("Visitantes")
}

/// Sem coluna `id` no export. A chave natural e (key, categoria), unica nas 35 linhas.
model PrecoRevista {
  key       String
  categoria String
  label     String
  preco     Decimal @db.Decimal(10, 2)

  @@id([key, categoria])
  @@map("Precos_Revistas")
}

/**
 * ==========================================================================
 * PEDIDOS DE REVISTAS
 * A aba `Pedidos_Revistas` existe no export e esta VAZIA — zero linhas. Nao ha
 * como inferir os campos de uma planilha sem dados, entao estas duas tabelas
 * sao novas, e nao uma importacao. Nada do sistema antigo e alterado por elas:
 * `Precos_Revistas` (35 linhas) e `Parametros` continuam intactos e sao a
 * fonte dos precos.
 * A ligacao que faz o modulo funcionar ja existia no cadastro: `Classes.tipoClasse`
 * usa exatamente os mesmos valores de `Precos_Revistas.categoria` — "adultos",
 * "juniores", "adolesc"... Por isso o pedido de uma classe pode nascer
 * preenchido: uma revista de aluno por aluno matriculado, uma de professor por
 * professor da classe.
 * ==========================================================================
 */

/// Um pedido de revistas de uma classe, num trimestre.
model PedidoRevista {
  id Int @id @default(autoincrement())

  congId   Int?
  classeId Int?

  ano       Int
  /// 1 a 4. Guardado como numero, e nao "2T": trimestre e ordenavel e
  /// comparavel; texto nao é — "10T" viria antes de "2T" em qualquer ordenacao.
  trimestre Int

  /// "rascunho" | "enviado" | "atendido"
  ///
  /// Rascunho e o estado util: a classe monta o pedido ao longo de dias, sem
  /// que a secretaria do campo o veja como definitivo. Sem esse estado, ou o
  /// pedido nasce publico pela metade, ou so pode ser criado de uma sentada.
  situacao String @default("rascunho")

  observacao String?

  /// Quem montou. Texto, e nao FK: e o nome de quem estava logado no momento,
  /// e ele nao pode mudar depois se a pessoa for renomeada no cadastro.
  autor String?

  criadoEm   DateTime  @default(now())
  atualizado DateTime  @updatedAt
  enviadoEm  DateTime?

  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])

  itens PedidoRevistaItem[]

  /// Um pedido por classe por trimestre. Sem isto, dois professores da mesma
  /// classe abrem dois pedidos no mesmo trimestre e a secretaria recebe o dobro
  /// de revistas — sem ninguem perceber ate a entrega chegar.
  @@unique([classeId, ano, trimestre])
  @@index([congId])
  @@index([ano, trimestre])
  /// A aba de mesmo nome existe no export e esta vazia, entao nao ha tabela
  /// com este nome no Postgres — o nome fica livre e e o nome certo.
  @@map("Pedidos_Revistas")
}

/// Uma linha do pedido: qual revista, quantas, por quanto.
model PedidoRevistaItem {
  id Int @id @default(autoincrement())

  pedidoId Int

  /// Apontam para `Precos_Revistas` (key, categoria). NAO ha chave estrangeira
  /// de proposito: aquela tabela e do sistema antigo, e uma FK daqui para la
  /// impediria a secretaria de corrigir um preco sem antes mexer nos pedidos.
  categoria String
  chave     String
  /// Copia do rotulo no momento do pedido — ver `precoUnitario`.
  label     String

  quantidade Int

  /**
   * O preco CONGELADO no momento do pedido.
   * Ler o preco atual na hora de exibir faria o pedido de abril mudar de valor
   * sozinho quando a tabela de precos fosse atualizada em julho — e a
   * prestacao de contas de um trimestre fechado deixaria de bater com o que foi
   * pago. Um pedido e um documento; ele guarda o que valia quando foi feito.
   */
  precoUnitario Decimal @db.Decimal(10, 2)

  pedido PedidoRevista @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@unique([pedidoId, categoria, chave])
  @@index([pedidoId])
  @@map("Pedidos_Revistas_Itens")
}

/// Sem coluna `id` no export; `parametro` e unico.
model Parametro {
  parametro String  @id
  valor     Decimal @db.Decimal(10, 2)

  @@map("Parametros")
}

model Reuniao {
  id            Int      @id
  legacyId      Int?
  titulo        String
  tipo          String
  data          DateTime @db.Date
  local         String?
  obs           String?
  autor         String
  /// No export e uma STRING com JSON serializado: [{"nome":..,"presente":bool}].
  /// A importacao faz o parse e grava como jsonb (13/13 linhas validadas).
  participantes Json
  presentes     Int
  total         Int
  registradoEm  DateTime

  @@map("Reunioes")
}

model EscalaCulto {
  id          Int      @id
  legacyId    Int?
  titulo      String
  mesAno      DateTime @db.Date
  dataUpload  DateTime @db.Date
  nomeArquivo String
  url         String
  urlPreview  String
  obs         String?
  autor       String
  congId      Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Escala_Cultos")
}

model Evento {
  id        Int      @id
  legacyId  Int?
  titulo    String
  descricao String
  tipo      String
  local     String
  data      DateTime @db.Date
  dataFim   DateTime @db.Date
  obs       String?
  congId    Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Eventos")
}

model Aviso {
  id             Int      @id
  legacyId       Int?
  titulo         String
  texto          String
  prioridade     Int
  dataPublicacao DateTime @db.Date
  dataExpiracao  DateTime @db.Date
  autor          String
  congId         Int?

  congregacao Congregacao? @relation(fields: [congId], references: [id])

  @@index([congId])
  @@map("Avisos")
}

model Auditoria {
  id       Int      @id
  legacyId Int?
  /// Timestamp ISO completo no export.
  when     DateTime
  who      String
  whoLogin String
  action   String
  entidade String
  desc     String

  @@index([when])
  @@index([whoLogin])
  @@map("Auditoria")
}

model Versiculo {
  id       Int     @id
  legacyId Int?
  ref      String
  texto    String
  ativo    Boolean @default(true)

  @@map("Versiculos")
}

/**
 * ==========================================================================
 * PESSOAS E CARGOS
 * O sistema antigo nao tinha cadastro de pessoas, e por isso nao conseguia
 * contar gente. Ele tinha duas coisas diferentes:
 * Usuarios  — 19 linhas, mas a maioria nao e pessoa nenhuma: sao contas de
 * congregacao ("Cong. Pinheiro", "T. Matriz", "Templo Sede").
 * Classes.prof — texto livre, digitado por quem cadastrou a classe. Os 50
 * preenchidos produzem 47 textos distintos, e entre eles estao
 * "Ana costa", "Ana maria da costa" e "Ana Maria costa" (a mesma
 * pessoa), "Jéssica e Elisângela" (DUAS pessoas num campo so) e
 * "Classe Juniores" (que nao e pessoa alguma).
 * Contar professores nesse arranjo e impossivel: quem da aula em duas classes
 * vira duas pessoas, e quem e dirigente e professor vira duas de novo.
 * A modelagem abaixo separa QUEM (Pessoa) de O QUE FAZ (Cargo), ligados por
 * PessoaCargo. Uma pessoa pode acumular quantos cargos exercer — e continua
 * sendo uma linha em Pessoa, que e o numero que o Dashboard mostra.
 * ==========================================================================
 */

/// Cadastro unico de gente. Uma linha por PESSOA, nunca por funcao.
model Pessoa {
  id Int @id @default(autoincrement())

  /// Nome civil, SEM tratamento eclesiastico. "Aílton José Alves", nao
  /// "Pr. Aílton José Alves" — senao a mesma pessoa se duplica no dia em que
  /// alguem digitar sem o prefixo, que e exatamente como o texto livre das
  /// classes se multiplicou.
  nome String

  /// Tratamento: "Pr.", "Pb.", "Dc.", "Aux.", "Ir.ª". Guardado a parte para a
  /// exibicao poder ser respeitosa sem contaminar a identidade.
  tratamento String?

  /// Forma normalizada do nome (minusculo, sem acento, sem tratamento).
  /// Existe para impedir "Andreyna Magalhaes" e "Andreyna Magslhaes" de virarem
  /// duas pessoas — e por ser UNIQUE, o banco recusa a duplicata em vez de
  /// depender de a aplicacao lembrar de conferir.
  chave String @unique

  tel   String?
  email String?
  /// Caminho da foto. Quase sempre nulo: o cadastro herdado nao tem fotos.
  foto  String?
  nasc  DateTime? @db.Date

  ativo Boolean @default(true)

  /// Marcada quando a importacao SUSPEITOU de duplicidade mas nao teve certeza
  /// — "Ana costa" e "Ana Maria costa" podem ser a mesma pessoa ou nao. A regra
  /// da igreja e nao alterar registro do sistema antigo por conta propria,
  /// entao a duvida fica registrada para um humano decidir, em vez de o
  /// programa fundir as duas e ninguem mais descobrir.
  revisar    Boolean @default(false)
  observacao String?

  criadoEm   DateTime @default(now())
  atualizado DateTime @updatedAt

  cargos  PessoaCargo[]
  usuario Usuario?

  @@index([nome])
  @@map("Pessoas")
}

/// Lista de funcoes. E dado, nao codigo: cadastrar um cargo novo nao exige
/// alterar o sistema.
model Cargo {
  id Int @id @default(autoincrement())

  nome String @unique

  /// Posicao na hierarquia — MENOR e mais alto. E o que ordena o card
  /// "Liderança do Campo" sem que a ordem esteja escrita em nenhum componente.
  /// Numerado de 10 em 10 para caber um cargo novo no meio sem renumerar tudo.
  ordem Int

  /// "campo" | "congregacao" | "classe" — a que altura o cargo se exerce.
  /// Um Pastor Presidente e do campo inteiro; um Professor, de uma classe.
  escopo String

  /// Aparece no card institucional do Dashboard.
  destaque Boolean @default(false)

  ativo Boolean @default(true)

  vinculos PessoaCargo[]

  @@index([ordem])
  @@map("Cargos")
}

/// O vinculo: esta pessoa exerce este cargo, aqui.
///
/// A linha e o cargo OCUPADO. Duas linhas da mesma pessoa somam dois cargos e
/// uma pessoa — que e precisamente a distincao que o Dashboard precisa mostrar.
model PessoaCargo {
  id Int @id @default(autoincrement())

  pessoaId Int
  cargoId  Int

  /// Onde exerce. Nulo em cargo de campo, que nao pertence a uma congregacao.
  congId   Int?
  /// Preenchido apenas em cargo de classe (professor, secretario de classe).
  classeId Int?

  inicio DateTime? @db.Date
  /// Preenchido quando a pessoa deixa a funcao. O vinculo NAO e apagado: a
  /// escala do ano passado precisa continuar dizendo quem dava a aula.
  fim    DateTime? @db.Date

  ativo Boolean @default(true)

  /// Texto de origem quando o vinculo veio da importacao — por exemplo
  /// "Pb. Lourival e Aux. Danilo", que gerou dois vinculos. Guardado para
  /// qualquer conferencia futura poder voltar ao que estava escrito.
  origem String?

  criadoEm DateTime @default(now())

  pessoa      Pessoa       @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  cargo       Cargo        @relation(fields: [cargoId], references: [id])
  congregacao Congregacao? @relation(fields: [congId], references: [id])
  classe      Classe?      @relation(fields: [classeId], references: [id])

  /// Impede o mesmo vinculo duas vezes. ATENCAO: em Postgres, NULL nao e igual
  /// a NULL, entao esta restricao sozinha NAO cobre os cargos de campo (congId
  /// e classeId nulos). A migration acrescenta o mesmo indice com
  /// NULLS NOT DISTINCT, que fecha o buraco.
  @@unique([pessoaId, cargoId, congId, classeId])
  @@index([pessoaId])
  @@index([cargoId])
  @@index([congId])
  @@index([classeId])
  @@map("PessoaCargos")
}
